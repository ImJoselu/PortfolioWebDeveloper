---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { withBase } from '../i18n/utils';
import { photo, links, skills } from '../data/profile';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const heroStack = [...skills.backend.slice(0, 2), ...skills.frontend.slice(0, 3), skills.integrations[0]];
---

<section class="relative overflow-hidden">
  <svg class="pointer-events-none absolute inset-0 -z-10 h-full w-full opacity-[0.06]" aria-hidden="true">
    <defs>
      <pattern id="hero-grid" width="64" height="64" patternUnits="userSpaceOnUse">
        <path d="M0 0H64M0 0V64" stroke="currentColor" stroke-width="1" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#hero-grid)" />
  </svg>

  <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 pb-16 pt-14 sm:px-6 sm:pt-20 lg:flex-row lg:items-center lg:gap-14 lg:pb-24 lg:pt-24">
    <div class="max-w-2xl">
      <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{dict.hero.kicker}</p>
      <h1 class="mt-4 text-3xl font-semibold leading-tight tracking-tight text-text sm:text-4xl lg:text-5xl">
        {dict.hero.heading}
      </h1>
      <p class="mt-5 text-base leading-relaxed text-text-muted sm:text-lg">
        {dict.hero.subheading}
      </p>

      <div class="mt-5 inline-flex items-center gap-2 rounded-full border border-border bg-bg-elevated px-3 py-1.5 text-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
        </span>
        {dict.hero.statusBadge}
      </div>

      <ul class="mt-6 flex flex-wrap gap-2 font-mono text-xs text-text-muted" aria-label={dict.skills.title}>
        {heroStack.map((tech) => <li class="rounded border border-border px-2.5 py-1">{tech}</li>)}
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#projects"
          class="inline-flex items-center gap-2 rounded bg-accent px-4 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
        >
          {dict.hero.ctaProjects}
          <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a
          href="#experience"
          class="inline-flex items-center gap-2 rounded border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          {dict.hero.ctaExperience}
        </a>
        <a
          href="#contact"
          class="inline-flex items-center gap-2 rounded border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          {dict.hero.ctaContact}
        </a>
        <a
          href={withBase(links.cvPath)}
          download
          class="inline-flex items-center gap-2 rounded border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:border-accent hover:text-accent"
        >
          <Icon name="download" class="h-4 w-4" />
          {dict.hero.ctaCv}
        </a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-[280px] shrink-0 lg:mx-0 lg:max-w-[320px]">
      <div class="relative rounded-2xl border border-border bg-bg-elevated p-2">
        <Image
          src={photo}
          alt={dict.hero.photoAlt}
          width={320}
          height={320}
          class="aspect-square w-full rounded-xl object-cover"
        />
        <span class="absolute -bottom-3 -right-3 flex h-11 w-11 items-center justify-center rounded-lg bg-accent text-accent-contrast shadow-sm">
          <svg viewBox="0 0 64 64" class="h-6 w-6" aria-hidden="true">
            <circle cx="20" cy="44" r="5.5" fill="currentColor" />
            <circle cx="44" cy="20" r="5.5" fill="currentColor" />
            <path
              d="M20 44 L20 26 L44 26 L44 20"
              fill="none"
              stroke="currentColor"
              stroke-width="4.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

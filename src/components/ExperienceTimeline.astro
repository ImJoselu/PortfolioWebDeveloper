---
import Section from './Section.astro';
import { experience } from '../data/profile';
import { formatPeriod } from '../i18n/utils';
import type { Dictionary } from '../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<Section id="experience" kicker={dict.experience.kicker} title={dict.experience.title}>
  <ol class="relative space-y-12 border-l border-border pl-8 sm:pl-10">
    {
      experience.map((job) => {
        const item = dict.experience.items[job.id];
        return (
          <li class="reveal relative">
            <span
              class="absolute -left-8 top-1.5 h-3 w-3 -translate-x-1/2 rounded-full bg-accent sm:-left-10"
              aria-hidden="true"
            />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-lg font-semibold text-text">
                {item.role} <span class="text-text-muted">·</span> {job.company}
              </h3>
              <p class="font-mono text-xs text-text-muted">{formatPeriod(job.period, dict.experience.present)}</p>
            </div>
            <p class="mt-1 text-text-muted">{item.summary}</p>
            <ul class="mt-3 space-y-2 text-sm text-text-muted">
              {item.bullets.map((bullet) => (
                <li class="flex gap-2.5">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="mt-4">
              <p class="font-mono text-xs uppercase tracking-widest text-text-muted">{dict.experience.stackLabel}</p>
              <ul class="mt-2 flex flex-wrap gap-2 font-mono text-xs">
                {job.stack.map((tech) => (
                  <li class="rounded border border-border px-2 py-1 text-text-muted">{tech}</li>
                ))}
              </ul>
            </div>
          </li>
        );
      })
    }
  </ol>
</Section>

---
interface Props {
  id: string;
  kicker?: string;
  title?: string;
  intro?: string;
}

const { id, kicker, title, intro } = Astro.props;
const headingId = `${id}-heading`;
---

<section id={id} data-section-root={id} class="scroll-mt-24 border-t border-border py-16 sm:py-20" aria-labelledby={title ? headingId : undefined}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      (kicker || title) && (
        <div class="reveal mb-10 max-w-2xl">
          {kicker && <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{kicker}</p>}
          {title && (
            <h2 id={headingId} class="mt-2 text-2xl font-semibold tracking-tight text-text sm:text-3xl">
              {title}
            </h2>
          )}
          {intro && <p class="mt-3 text-text-muted">{intro}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>

---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/profile';
import type { Dictionary } from '../i18n/types';

interface Props {
  project: Project;
  item: Dictionary['projects']['items'][keyof Dictionary['projects']['items']];
  dict: Dictionary;
}

const { project, item, dict } = Astro.props;
---

<article class="reveal group flex h-full flex-col overflow-hidden rounded-lg border border-border bg-bg-elevated">
  <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="block overflow-hidden">
    <Image
      src={project.image}
      alt={item.name}
      width={640}
      height={400}
      loading="lazy"
      class="aspect-[8/5] w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
    />
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="text-lg font-semibold text-text">{item.name}</h3>
    <p class="text-sm leading-relaxed text-text-muted">{item.description}</p>

    <p class="mt-auto pt-2 font-mono text-xs text-text-muted">
      <span class="uppercase tracking-widest">{dict.projects.roleLabel}:</span> {dict.projects.roleValue}
    </p>

    <ul class="flex flex-wrap gap-2 font-mono text-xs">
      {project.stack.map((tech) => <li class="rounded border border-border px-2 py-1 text-text-muted">{tech}</li>)}
    </ul>

    <a
      href={project.repoUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-1 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
    >
      {dict.projects.viewRepo}
      <Icon name="external" class="h-3.5 w-3.5" />
    </a>
  </div>
</article>

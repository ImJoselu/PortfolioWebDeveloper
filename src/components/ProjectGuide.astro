---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { withBase, homePath, projectGuidePath } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
import type { Project } from '../data/profile';
import type { Dictionary, ProjectGuideCopy } from '../i18n/types';

interface Props {
  lang: Lang;
  dict: Dictionary;
  project: Project;
  item: Dictionary['projects']['items'][keyof Dictionary['projects']['items']];
  guide: ProjectGuideCopy;
}

const { lang, dict, project, item, guide } = Astro.props;

const slug = project.guide!.slug;
const shots = project.guide!.shots;
const portraitShots = project.guide!.portraitShots ?? [];

const projectsHref = `${withBase(homePath(lang))}#projects`;
const otherLangHref = withBase(projectGuidePath(lang === 'es' ? 'en' : 'es', slug));

// Only render tour entries whose screenshot actually exists in profile.ts, so a
// copy entry added before its image never breaks the build.
const tourShots = guide.shots.filter((shot) => shots[shot.id]);
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/90 backdrop-blur supports-[backdrop-filter]:bg-bg/75">
  <div class="mx-auto flex max-w-4xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
    <a href={projectsHref} class="inline-flex items-center gap-1.5 text-sm text-text-muted transition-colors hover:text-accent">
      <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
      {dict.projectGuide.backToProjects}
    </a>

    <div class="flex items-center gap-1.5 sm:gap-2">
      <a
        href={otherLangHref}
        class="inline-flex items-center gap-1.5 rounded border border-border px-2.5 py-1.5 text-sm transition-colors hover:border-accent hover:text-accent"
        aria-label={dict.languageSwitch.ariaLabel}
        hreflang={lang === 'es' ? 'en' : 'es'}
      >
        <Icon name="globe" class="h-4 w-4" />
        <span class="hidden sm:inline">{dict.languageSwitch.label}</span>
      </a>

      <button
        type="button"
        id="theme-toggle"
        class="inline-flex h-9 w-9 items-center justify-center rounded border border-border transition-colors hover:border-accent hover:text-accent"
        aria-label={dict.theme.toggleToDark}
        data-label-dark={dict.theme.toggleToDark}
        data-label-light={dict.theme.toggleToLight}
      >
        <Icon name="moon" class="theme-icon-dark h-4 w-4" />
        <Icon name="sun" class="theme-icon-light hidden h-4 w-4" />
      </button>
    </div>
  </div>
</header>

<main id="main-content" class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
  <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{dict.projectGuide.kicker}</p>
  <h1 class="mt-2 text-3xl font-semibold tracking-tight text-text sm:text-4xl">{item.name}</h1>
  <p class="mt-3 text-lg text-text-muted">{guide.tagline}</p>

  <div class="mt-8 overflow-hidden rounded-lg border border-border bg-bg-elevated">
    <Image
      src={project.image}
      alt={item.name}
      width={800}
      height={500}
      loading="eager"
      class="mx-auto max-h-72 w-auto object-contain p-8"
    />
  </div>

  <div class="mt-8 space-y-4 text-text-muted">
    {guide.intro.map((paragraph) => <p class="leading-relaxed">{paragraph}</p>)}
  </div>

  <a
    href={project.repoUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline"
  >
    <Icon name="github" class="h-4 w-4" />
    {dict.projectGuide.repoLabel}
  </a>

  <section class="mt-14 border-t border-border pt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-text">{guide.tourTitle}</h2>

    <ol class="mt-8 space-y-14">
      {
        tourShots.map((shot, index) => (
          <li class="reveal">
            <p class="font-mono text-xs uppercase tracking-widest text-text-muted">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-1 text-lg font-semibold text-text">{shot.title}</h3>
            <p class="mt-2 max-w-2xl leading-relaxed text-text-muted">{shot.description}</p>
            <figure
              class:list={[
                'mt-4 overflow-hidden rounded-lg border border-border bg-bg-elevated',
                portraitShots.includes(shot.id) && 'max-w-xs',
              ]}
            >
              <a href={shots[shot.id].src} target="_blank" rel="noopener noreferrer">
                <Image
                  src={shots[shot.id]}
                  alt={`${item.name} — ${shot.title}`}
                  loading="lazy"
                  class="w-full"
                />
              </a>
            </figure>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mt-14 border-t border-border pt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-text">{guide.highlightsTitle}</h2>
    <ul class="mt-6 space-y-3">
      {
        guide.highlights.map((highlight) => (
          <li class="flex items-start gap-3 text-text-muted">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" />
            <span class="leading-relaxed">{highlight}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-14 border-t border-border pt-10">
    <h2 class="text-2xl font-semibold tracking-tight text-text">{guide.stackTitle}</h2>
    <ul class="mt-6 flex flex-wrap gap-2 font-mono text-xs">
      {project.stack.map((tech) => <li class="rounded border border-border px-3 py-1.5 text-text">{tech}</li>)}
    </ul>
  </section>

  <a href={projectsHref} class="mt-14 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:underline">
    <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
    {dict.projectGuide.backToProjects}
  </a>
</main>

<script>
  // Same contract as the theme toggle in Header.astro — the pre-paint script in
  // BaseLayout has already applied any stored preference by the time this runs.
  const THEME_KEY = 'theme';
  const root = document.documentElement;
  const themeToggle = document.getElementById('theme-toggle');

  function isDark(): boolean {
    const attr = root.getAttribute('data-theme');
    if (attr === 'dark') return true;
    if (attr === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function syncThemeIcon() {
    const dark = isDark();
    document.querySelectorAll<HTMLElement>('.theme-icon-dark').forEach((el) => el.classList.toggle('hidden', dark));
    document.querySelectorAll<HTMLElement>('.theme-icon-light').forEach((el) => el.classList.toggle('hidden', !dark));
    if (themeToggle) {
      const label = dark ? themeToggle.dataset.labelLight : themeToggle.dataset.labelDark;
      if (label) themeToggle.setAttribute('aria-label', label);
    }
  }

  themeToggle?.addEventListener('click', () => {
    const nextTheme = isDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', nextTheme);
    try {
      localStorage.setItem(THEME_KEY, nextTheme);
    } catch {
      /* ignore */
    }
    syncThemeIcon();
  });

  syncThemeIcon();
</script>
